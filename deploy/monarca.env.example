# Configuración del servidor en la mini PC. Copiar a /etc/monarca/monarca.env
PORT=3000
HOST=0.0.0.0
TZ=America/Guatemala
MONARCA_DB=/var/lib/monarca/monarca.db
STATIC_DIR=/opt/monarca/frontend/dist
# Con qué arranca una base nueva: vacio (catálogos sin movimientos) o demo (datos de ejemplo)
MONARCA_SEED=vacio
# 1 solo para una instalación de demostración ("Restaurar datos de ejemplo")
MONARCA_DEMO=0
LOG_LEVEL=warn
