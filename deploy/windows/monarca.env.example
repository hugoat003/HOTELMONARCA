# Configuración del servidor en la mini PC (Windows). Va en C:\ProgramData\Monarca\monarca.env
PORT=3000
HOST=0.0.0.0
TZ=America/Guatemala
MONARCA_DB=C:\ProgramData\Monarca\monarca.db
STATIC_DIR=C:\Monarca\app\frontend\dist
# Con qué arranca una base nueva: vacio (catálogos sin movimientos) o demo (datos de ejemplo)
MONARCA_SEED=vacio
# 1 solo para una instalación de demostración ("Restaurar datos de ejemplo")
MONARCA_DEMO=0
LOG_LEVEL=warn

# ----- Respaldos (ver deploy/README.md → Respaldos)
# Cada noche a esta hora (0-23) se copia la base a C:\ProgramData\Monarca\respaldos
MONARCA_RESPALDO_HORA=3
# Copia fuera del hotel, comprimida y cifrada: Cloudflare R2 (o cualquier almacenamiento compatible con S3)
#MONARCA_S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
#MONARCA_S3_BUCKET=monarca-respaldos
#MONARCA_S3_KEY_ID=
#MONARCA_S3_SECRET=
# La clave para cifrar la genera instalar.ps1 (MONARCA_RESPALDO_CLAVE=…). Guárdala también fuera de la mini PC.
